# Copy this file to .env before running docker compose (setup.sh does this for you).
# These are LAB defaults for a local, isolated, deliberately vulnerable
# environment. Do not reuse SECRET_KEY, or these credentials/values, anywhere
# outside of this lab.

APP_NAME=AcmeFlow API

# Matches the `db` service in docker-compose.yml
DATABASE_URL=postgresql://acmeflow:acmeflow@db:5432/acmeflow

SECRET_KEY=lab-only-insecure-static-secret-do-not-reuse
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
